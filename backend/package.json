{
  "name": "ai-relocation-backend",
  "version": "0.1.0",
  "description": "AI-powered locality, commute, rent, and property intelligence platform backend in Express and TypeScript.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "tsx scripts/testEndpoints.ts",
    "test:bench": "tsx scripts/testRecommendationEngine.ts",
    "typecheck": "tsc --noEmit",
    "seed": "tsx scripts/seed.ts",
    "import-dataset": "tsx scripts/importMagicBricksDataset.ts",
    "scrape-housing": "tsx scripts/populatePropertyData.ts",
    "capture-housing-state": "tsx scripts/captureHousingStorageState.ts"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "commander": "^13.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "mongodb": "^6.12.0",
    "morgan": "^1.10.0",
    "openai": "^4.85.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "playwright": "^1.50.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.13.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
