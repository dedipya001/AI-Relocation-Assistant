OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Maps & Geolocation
MAPBOX_ACCESS_TOKEN=pk.your_mapbox_public_token_here
GOOGLE_MAPS_API_KEY=

# Scrapers, Aggregation & Integrations
APIFY_TOKEN=
